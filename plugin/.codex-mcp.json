{
  "mcpServers": {
    "pathtrove": {
      "command": "python3",
      "args": [
        "./bin/pathtrove",
        "mcp"
      ],
      "cwd": ".",
      "env_vars": [
        "PATHTROVE_HOME",
        "PATHTROVE_LANG",
        "PATHTROVE_WEB",
        "HF_ENDPOINT",
        "HTTPS_PROXY",
        "HTTP_PROXY",
        "ALL_PROXY",
        "NO_PROXY",
        "https_proxy",
        "http_proxy",
        "all_proxy",
        "no_proxy"
      ],
      "default_tools_approval_mode": "approve"
    }
  }
}
